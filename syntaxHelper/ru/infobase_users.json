      "kind": "collection",
      "category_keys": ["global_context"],
      "signature": "InfoBaseUsers",
      "description": "Пользователи этой информационной базы. CurrentUser — пользователь этого сеанса. GetUsers — все пользователи, записанные в базе, или пустой массив, если таблицы пользователей нет. У пользователя есть Name, FullName и UUID. Это чтение 1С ПользователиИнформационнойБазы.",
      "parameters": "None.",
      "return_descr": "Объект InfoBaseUsers.",
      "example": "user = InfoBaseUsers.CurrentUser();\nname = user.Name;",
      "availability": "Designer, enterprise, codeRunner, daemon, wenterprise-server",
      "see_also": ["mth.InfoBaseUsers.CurrentUser", "mth.InfoBaseUsers.GetUsers"],
      "reviewed": false
    },
    {
      "id": "mth.InfoBaseUsers.CurrentUser",
      "name_local": "CurrentUser",
      "name_en": "CurrentUser",
      "kind": "method",
      "category_keys": ["global_context"],
      "signature": "CurrentUser()",
      "description": "Пользователь этого сеанса. Если у сеанса нет пользователя, Name, FullName и UUID пусты.",
      "parameters": "None.",
      "return_descr": "Пользователь (Name, FullName, UUID).",
      "example": "name = InfoBaseUsers.CurrentUser().Name;",
      "availability": "Designer, enterprise, codeRunner, daemon, wenterprise-server",
      "see_also": ["cls.InfoBaseUsers"],
      "reviewed": false
    },
    {
      "id": "mth.InfoBaseUsers.GetUsers",
      "name_local": "GetUsers",
      "name_en": "GetUsers",
      "kind": "method",
      "category_keys": ["global_context"],
      "signature": "GetUsers()",
      "description": "Все пользователи, записанные в этой базе. Пустой массив, если таблицы пользователей нет.",
      "parameters": "None.",
      "return_descr": "Массив пользователей.",
      "example": "users = InfoBaseUsers.GetUsers();",
      "availability": "Designer, enterprise, codeRunner, daemon, wenterprise-server",
      "see_also": ["cls.InfoBaseUsers"],
      "reviewed": false
    }
